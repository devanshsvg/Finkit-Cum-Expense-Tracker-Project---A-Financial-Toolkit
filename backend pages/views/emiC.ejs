<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EMI CALCULATOR</title>
</head>
<body>
    <h1>EMI CALCULATOR</h1>
    <h3>Take the loan is the best way possible</h3>
    <form method="POST" action="/finkit/emicalculator">
        Loan Amount  <input type="number" required name="p" placeholder="amount">
        Rate of Interest <input type="number" required name="r" placeholder="rate"> %
        Time of Investment (in years) <input type="number" required name="t" placeholder="Time">
        <button type="submit">Submit</button>
    </form>
 <%if (result!==null){ %>
    <div class="result">
        <p>RESULT </p>
       
            <p>EMI: <%=result%> </p> 
            <p>Interest Paid <%=interestPaid%></p>
            <p> Total Amount paid <%=totalAmt%></p>
        <%} %>

    </div>

</body>
</html>